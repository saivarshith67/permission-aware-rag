# LLM provider: openai | openrouter | gemini
LLM_PROVIDER="openrouter"

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# OpenRouter (when LLM_PROVIDER=openrouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_NAME="permission-aware-rag"
# OPENROUTER_HTTP_REFERER="http://localhost"

# Gemini (when LLM_PROVIDER=gemini) — https://aistudio.google.com/apikey
GOOGLE_API_KEY="..."
GEMINI_MODEL="gemini-3.6-flash"

# Keycloak (local IAM — no GCP/AWS required)
KEYCLOAK_URL="http://localhost:8081"
KEYCLOAK_ADMIN="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
KEYCLOAK_REALM="permission-aware-rag"
KEYCLOAK_CLIENT_ID="permission-aware-rag-client"
KEYCLOAK_USER_PASSWORD="password"

# Optional: limit Keycloak resources for faster local setup (set to 0 for full ~13k)
KEYCLOAK_RESOURCE_LIMIT=500

# Quantitative evaluation (script 08) — paper uses 1000; 100 is faster for dry runs
EVAL_SAMPLE_SIZE=1000
EVAL_SEED=42
